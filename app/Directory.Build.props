<Project>
  <!-- Build output outside OneDrive (the repository's Directory.Build.props: ~\.nexus\build\NexusSystem\<project>). -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />
  <!-- The app's version, its only source: assemblies, NexusSystem.exe's file version and, through tools/package.ps1,
       the package manifest. Four numbers ending in .0 (the Store reserves the last one). -->
  <PropertyGroup>
    <Version>1.0.13.0</Version>
  </PropertyGroup>
</Project>
