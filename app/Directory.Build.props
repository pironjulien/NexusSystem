<Project>
  <!-- Build output outside OneDrive: bin/obj (about 1.5 GB) would otherwise fill the 5 GB OneDrive quota and be
       synced on every build. One folder per project under %LOCALAPPDATA%\NexusApps\build. -->
  <PropertyGroup>
    <NexusBuildRoot>$([System.Environment]::GetFolderPath(SpecialFolder.LocalApplicationData))\NexusApps\build\$(MSBuildProjectName)\</NexusBuildRoot>
    <BaseOutputPath>$(NexusBuildRoot)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(NexusBuildRoot)obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <!-- The app's version, its only source: assemblies, NexusSystem.exe's file version and, through tools/package.ps1,
       the package manifest. Four numbers ending in .0 (the Store reserves the last one). -->
  <PropertyGroup>
    <Version>1.0.10.0</Version>
  </PropertyGroup>
</Project>
