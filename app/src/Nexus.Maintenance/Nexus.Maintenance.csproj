<Project Sdk="Microsoft.NET.Sdk">
  <!-- The hourly maintenance engine: a small native executable (AOT, no .NET to install, no window), started directly
       by the "NexusSystem Update" task and published with each NexusSystem catalog release (NexusMaintenance-x64.exe,
       NexusMaintenance-arm64.exe). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>NexusMaintenance</AssemblyName>
    <RootNamespace>Nexus.Maintenance</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- The two packages below are pinned on purpose (see there): their "delete explicit reference" notice is answered. -->
    <SuppressGenerateILCompilerExplicitPackageReferenceWarning>true</SuppressGenerateILCompilerExplicitPackageReferenceWarning>
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
    <!-- Its version is the catalog release it ships with: get-nexus.ps1's $NexusMaintenanceVersion, the only source. -->
    <NexusCatalogScript>$(MSBuildThisFileDirectory)..\..\..\get-nexus.ps1</NexusCatalogScript>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(NexusCatalogScript)')), `(?&lt;=\$NexusMaintenanceVersion = ')\d+\.\d+\.\d+(?=')`))</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- The AOT compiler and the trimmer, pinned like any package (packages.lock.json, Dependabot): left implicit, their
         version would follow the .NET SDK of the machine and break the locked restore whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
  </ItemGroup>
  <Target Name="NexusCatalogVersion" BeforeTargets="Build;Publish">
    <Error Condition="'$(Version)' == ''" Text="get-nexus.ps1 carries no `$NexusMaintenanceVersion = 'x.y.z'`." />
  </Target>
</Project>
