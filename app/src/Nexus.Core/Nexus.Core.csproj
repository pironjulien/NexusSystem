<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Also compiled into the native (AOT) maintenance engine: no WMI or reflection-based serialization here. -->
    <IsAotCompatible>true</IsAotCompatible>
    <!-- LibraryImport (source-generated Windows calls) emits its marshalling stubs as unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The engine's two architectures in the restore graph: a publish with -r restores this reference for that runtime,
         which packages.lock.json must already cover (locked restore in CI). -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Microsoft.NET.ILLink.Tasks is pinned on purpose (see there): its "delete explicit reference" notice is answered. -->
    <SuppressILLinkExplicitPackageReferenceWarning>true</SuppressILLinkExplicitPackageReferenceWarning>
  </PropertyGroup>
  <ItemGroup>
    <!-- The trimmer's tasks (their analyzers serve IsAotCompatible), pinned like any package (packages.lock.json,
         Dependabot): left implicit, their version would follow the .NET SDK of the machine and break the locked restore
         whenever the CI's SDK moves. -->
    <PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Nexus.Core.Tests" />
  </ItemGroup>
  <PropertyGroup>
    <!-- The catalog release this build belongs to: get-nexus.ps1's $NexusMaintenanceVersion, the only source. The app
         installs the maintenance engine of that release (MaintenanceSetup.CatalogVersion). -->
    <NexusCatalogScript>$(MSBuildThisFileDirectory)..\..\..\get-nexus.ps1</NexusCatalogScript>
    <NexusCatalogVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(NexusCatalogScript)')), `(?&lt;=\$NexusMaintenanceVersion = ')\d+\.\d+\.\d+(?=')`))</NexusCatalogVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="NexusCatalogVersion" Value="$(NexusCatalogVersion)" />
  </ItemGroup>
  <Target Name="NexusCatalogVersion" BeforeTargets="Build;Publish">
    <Error Condition="'$(NexusCatalogVersion)' == ''" Text="get-nexus.ps1 carries no `$NexusMaintenanceVersion = 'x.y.z'`." />
  </Target>
</Project>
