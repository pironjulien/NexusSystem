<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Built against Windows 11 24H2 (the package's MaxVersionTested comes from it), runs from Windows 10 2004. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Nexus.App</RootNamespace>
    <AssemblyName>NexusSystem</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nexus.ico</ApplicationIcon>
    <!-- Unpackaged for local development (runs from its build folder, nothing installed); tools/package.ps1 packages it as
         MSIX for the Store (WindowsPackageType=MSIX at packaging). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- .NET itself goes in the package too: a PC without the .NET 10 Desktop Runtime (a new Windows) runs the app.
         ReadyToRun for the start time; no trimming (WinUI's XAML reflection breaks under it). -->
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Nexus.Core\Nexus.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\*.svg;Assets\*.ico;Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The SDK's unpackaged MRT path generates the application PRI but does not publish it (WindowsAppSDK#6720).
       Include the generated resource through the normal publish item pipeline, as its MSIX path already does. -->
  <Target Name="NexusPublishCompiledXamlResources" BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)" Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="The application's compiled XAML resource index is missing." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
