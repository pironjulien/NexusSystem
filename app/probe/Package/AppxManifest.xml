<?xml version="1.0" encoding="utf-8"?>
<!-- The probe as the Nexus app will ship: runFullTrust only, no unvirtualizedResources (measured on 25/10/2026: no
     effect on HKCU nor on an existing AppData file, so not worth a restricted capability). -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="NexusProbe" Publisher="CN=NexusProbeTest" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Nexus probe</DisplayName>
    <PublisherDisplayName>Nexus probe</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources><Resource Language="en-us" /></Resources>
  <Applications>
    <Application Id="Probe" Executable="NexusProbe.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Nexus probe" Description="MSIX container probe" BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
