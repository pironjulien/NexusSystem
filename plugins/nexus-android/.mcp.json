{
  "mcpServers": {
    "nexus-android": {
      "command": "uvx",
      "args": [
        "--python",
        "3.14",
        "nexus-android==0.20.3"
      ],
      "env": {
        "NEXUS_ANDROID_ADB": "${NEXUS_ANDROID_ADB:-}",
        "NEXUS_ANDROID_SERIAL": "${NEXUS_ANDROID_SERIAL:-}",
        "NEXUS_ANDROID_MANAGED": "nexus-plugins catalog"
      }
    }
  }
}
