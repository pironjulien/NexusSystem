{
  "mcpServers": {
    "nexus-windows": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "nexus-windows"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "PYTHONUTF8": "1"
      }
    }
  }
}
