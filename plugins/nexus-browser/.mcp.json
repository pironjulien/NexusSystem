{
  "mcpServers": {
    "nexus-browser": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--project",
        "${CLAUDE_PLUGIN_ROOT}",
        "nexus-browser"
      ],
      "env": {
        "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv",
        "NEXUS_BROWSER_AGENT": "Claude"
      }
    }
  }
}
