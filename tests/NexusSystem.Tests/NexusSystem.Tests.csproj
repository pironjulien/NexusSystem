<Project Sdk="Microsoft.NET.Sdk">
  <!-- The catalogs (Claude Code, Codex), the pack script and the repository's PowerShell checks. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>NexusSystem.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <Using Include="Xunit" />
    <AssemblyMetadata Include="NexusSystem.Repository" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..'))" />
  </ItemGroup>
</Project>