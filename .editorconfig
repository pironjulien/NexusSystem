# Shared C# style and analyzer settings (the build enforces them: see Directory.Build.props).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets,slnx,xml,manifest}]
indent_size = 2

[*.{cmd,bat}]
end_of_line = crlf

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
